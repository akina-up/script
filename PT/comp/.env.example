# 复制本文件为 .env，然后按实际情况修改。
# Copy this file to .env and adjust the values.

# ── 必填 / Required ────────────────────────────────────────────────

# 片源目录的绝对路径（宿主机上），会挂到容器里的 /comp
# Absolute path to your media directory on the host; mounted at /comp
MEDIA_DIR=/mnt/downloads

# 网页登录密码
# Web login password
WEBTOP_PASSWORD=change-me

# ── 可选 / Optional ────────────────────────────────────────────────

# 网页登录用户名 / Web login username
WEBTOP_USER=admin

# 容器内用户的 uid/gid。想让容器能写片源目录，就填该目录的属主
# uid/gid inside the container. To make the media dir writable, use its owner's.
PUID=1000
PGID=1000

TZ=Asia/Shanghai

# 宿主机端口 / Host ports
HTTP_PORT=3010
HTTPS_PORT=3011
