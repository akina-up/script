# 复制本文件为 .env，然后按实际情况修改。
# Copy this file to .env and adjust the values.
#
#   cp .env.example .env
#
# .env 里有密码，已被 .gitignore 排除 —— 打包发给别人时也记得排除掉。
# .env holds a password and is git-ignored — remember to exclude it from any
# archive you hand to someone else, too.

# ── 必填 / Required ────────────────────────────────────────────────

# 片源目录的绝对路径（宿主机上），会挂到容器里的 /comp
# Absolute path to your media directory on the host; mounted at /comp
MEDIA_DIR=/mnt/downloads

# 网页登录密码
# Web login password
WEBTOP_PASSWORD=change-me

# ── 可选 / Optional ────────────────────────────────────────────────

# 网页登录用户名
# Web login username
WEBTOP_USER=admin

# 容器内用户的 uid/gid。默认 1000 只能读片源目录；想让容器也能往那儿写
# （比如让 lsmas 把索引写在片子旁边），就填该目录属主的 uid/gid。
#
# uid/gid inside the container. The default 1000 can only read the media
# directory; to make it writable too (e.g. so lsmas can put its index next to
# the source), use the uid/gid that owns that directory.
PUID=1000
PGID=1000

# 时区，影响桌面和日志里的时间
# Timezone, affects the desktop clock and log timestamps
TZ=Asia/Shanghai

# 宿主机端口。访问要用 https://<主机>:${HTTPS_PORT}，HTTP 那个不工作。
# Host ports. Connect via https://<host>:${HTTPS_PORT} — plain HTTP won't work.
HTTP_PORT=3010
HTTPS_PORT=3011
